---
// Professional contact form — alternative conversion path to the Diagnostic chat.
// Posts to /api/lead.ts (Cloudflare Pages Function), which forwards to the
// lead-intake-v1 Make.com scenario (Notion CRM + Telegram alert + confirmation email).
---

<div class="contact-wrapper">
  <div class="contact-glass frame--glow">
      <form id="contact-form" class="contact-form" novalidate>
        <div class="contact-form__row">
          <div class="contact-form__field">
            <label for="cf-name">Name<span aria-hidden="true">*</span></label>
            <input
              type="text"
              id="cf-name"
              name="name"
              autocomplete="name"
              maxlength="200"
              required
              aria-required="true"
            />
          </div>
          <div class="contact-form__field">
            <label for="cf-email">Email<span aria-hidden="true">*</span></label>
            <input
              type="email"
              id="cf-email"
              name="email"
              autocomplete="email"
              maxlength="254"
              required
              aria-required="true"
            />
          </div>
        </div>

        <div class="contact-form__row">
          <div class="contact-form__field">
            <label for="cf-business">Business name<span aria-hidden="true">*</span></label>
            <input
              type="text"
              id="cf-business"
              name="business"
              autocomplete="organization"
              maxlength="200"
              required
              aria-required="true"
            />
          </div>
        </div>

        <div class="contact-form__field">
          <label for="cf-message">What's slowing you down? <span class="contact-form__optional">(optional)</span></label>
          <textarea id="cf-message" name="message" rows="3" maxlength="5000"></textarea>
        </div>

        <!-- Honeypot — hidden from real users, catches simple bots. -->
        <div class="contact-form__honeypot" aria-hidden="true">
          <label for="cf-company-website">Leave this field empty</label>
          <input type="text" id="cf-company-website" name="company_website" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" class="contact-form__send">
          <span class="contact-form__send-label">Send message</span>
        </button>
        <p
          id="contact-form-status"
          class="contact-form__status"
          role="status"
          aria-live="polite"
        ></p>
      </form>
  </div>

  <style>
    .contact-wrapper {
      max-width: var(--max-content);
      width: 100%;
      margin-inline: auto;
    }
    .contact-glass {
      max-width: 560px;
      background: linear-gradient(135deg, rgba(75, 186, 139, 0.08) 0%, rgba(62, 127, 168, 0.04) 100%);
      border: 1px solid rgba(75, 186, 139, 0.2);
      border-radius: 16px;
      padding: var(--space-12);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      position: relative;
    }
    .contact-form {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }
    .contact-form__row {
      display: grid;
      gap: 20px;
    }
    @media (min-width: 600px) {
      .contact-form__row {
        grid-template-columns: 1fr 1fr;
      }
    }
    .contact-form__field {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .contact-form__field label {
      font-family: var(--mono);
      font-size: var(--text-sm);
      letter-spacing: 0.06em;
      color: var(--ink);
      font-weight: 600;
      margin-bottom: 8px;
      display: block;
    }
    .contact-form__optional {
      color: var(--ink-3);
      font-weight: 400;
    }
    .contact-form__field input,
    .contact-form__field textarea {
      width: 100%;
      box-sizing: border-box;
      padding: 12px 14px;
      border-radius: 8px;
      border: 1px solid var(--rule);
      background: color-mix(in srgb, var(--surface-2) 70%, transparent);
      color: var(--ink);
      font-family: var(--display);
      font-size: var(--text-base);
      transition: border-color 0.18s ease, background 0.18s ease;
    }
    .contact-form__field input:focus,
    .contact-form__field textarea:focus {
      outline: none;
      border-color: var(--accent);
      background: color-mix(in srgb, var(--surface-2) 80%, transparent);
    }
    .contact-form__honeypot {
      display: none;
    }
    .contact-form__send {
      align-self: flex-start;
      margin-top: 12px;
      padding: 13px 28px;
      border-radius: 8px;
      border: 1px solid transparent;
      background: linear-gradient(180deg, var(--accent) 0%, #2e8a66 100%);
      color: #02110b;
      font-family: var(--display);
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.18s ease, box-shadow 0.18s ease;
      box-shadow: 0 0 0 1px rgba(75, 186, 139, 0.4), 0 8px 24px -10px rgba(75, 186, 139, 0.7);
    }
    .contact-form__send:hover {
      transform: translateY(-1px);
      box-shadow: 0 0 0 1px rgba(75, 186, 139, 0.4), 0 10px 30px -14px rgba(75, 186, 139, 0.9);
    }
    .contact-form__status {
      font-family: var(--mono);
      font-size: var(--text-xs);
      letter-spacing: 0.06em;
      color: var(--ink-2);
      margin: 0;
    }
  </style>

  <script type="module">
    // Inline form submit via fetch — sends JSON with a form_ts timestamp so the
    // /api/lead.ts honeypot + minimum-fill checks work as designed.
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('contact-form');
      const status = document.getElementById('contact-form-status');
      if (!form || !status) return;

      const formLoadTs = Date.now(); // captured on load, not on submit — the API's honeypot/min-fill-time check needs real elapsed time.

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formTs = formLoadTs;
        const formData = new FormData(form);
        const payload = {};
        for (const [key, value] of formData.entries()) {
          if (key === 'company_website') continue; // skip honeypot from client payload
          payload[key] = value;
        }
        payload.form_ts = formTs;

        status.textContent = 'Sending…';
        try {
          const res = await fetch('/api/lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (res.ok) {
            form.reset();
            status.textContent = 'Thanks — we’ll be in touch within 1 business day.';
          } else {
            status.textContent = data.error || 'Something went wrong. Please try again.';
          }
        } catch {
          status.textContent = 'Network error. Please try again.';
        }
      });
    });
  </script>

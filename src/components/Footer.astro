<footer class="footer">
  <div class="footer__container">
    <div class="footer__content">
      <p class="footer__tagline">
        SyncSet. Workflow automation for businesses that refuse to lose clients to slow replies.
      </p>
      <nav class="footer__links">
        <a href="/privacy/">Privacy Policy</a>
        <span class="footer__separator">·</span>
        <a href="/terms/">Terms of Service</a>
      </nav>
      <p class="footer__copyright">© 2026 SyncSet. All rights reserved.</p>
      <p class="footer__address">
        Byron Bay NSW 2481, Australia · <a href="mailto:contact@syncset.com.au">contact@syncset.com.au</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--surface);
    border-top: 1px solid var(--rule);
    padding: var(--space-16) var(--gutter);
    margin-top: var(--space-32);
  }

  .footer__container {
    max-width: var(--max-content);
    margin: 0 auto;
  }

  .footer__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .footer__tagline {
    font-size: var(--text-base);
    color: var(--graphite);
    line-height: 1.6;
  }

  .footer__links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .footer__links a {
    color: var(--ink);
    text-decoration: underline;
  }

  .footer__links a:hover {
    color: var(--graphite);
  }

  .footer__separator {
    color: var(--rule);
  }

  .footer__copyright {
    font-size: var(--text-sm);
    color: var(--graphite);
  }

  .footer__address {
    font-size: var(--text-xs);
    color: var(--graphite);
  }

  .footer__address a {
    color: var(--graphite);
    text-decoration: underline;
  }

  .footer__address a:hover {
    color: var(--ink);
  }
</style>

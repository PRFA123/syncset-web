---
// "Get your free Automation Diagnostic" — posts to /api/diagnostic.ts (Cloudflare
// Pages Function), which forwards to the diagnostic-audit-v1 Make.com scenario
// (Claude scoring + Notion CRM "Diagnostic" row + Telegram alert + emailed report).
// Same anti-spam / submit pattern as ContactForm.astro (honeypot + form_ts).
---

<div class="diagnostic-wrapper">
  <div class="diagnostic-glass frame--glow">
    <form id="diagnostic-form" class="diagnostic-form" novalidate>
      <div class="diagnostic-form__row">
        <div class="diagnostic-form__field">
          <label for="df-name">Name<span aria-hidden="true">*</span></label>
          <input type="text" id="df-name" name="name" autocomplete="name" maxlength="200" required aria-required="true" />
        </div>
        <div class="diagnostic-form__field">
          <label for="df-email">Email<span aria-hidden="true">*</span></label>
          <input type="email" id="df-email" name="email" autocomplete="email" maxlength="254" required aria-required="true" />
        </div>
      </div>

      <div class="diagnostic-form__row">
        <div class="diagnostic-form__field">
          <label for="df-phone">Phone <span class="diagnostic-form__optional">(optional)</span></label>
          <input type="tel" id="df-phone" name="phone" autocomplete="tel" maxlength="40" />
        </div>
        <div class="diagnostic-form__field">
          <label for="df-business">Business name<span aria-hidden="true">*</span></label>
          <input type="text" id="df-business" name="business" autocomplete="organization" maxlength="200" required aria-required="true" />
        </div>
      </div>

      <div class="diagnostic-form__row">
        <div class="diagnostic-form__field">
          <label for="df-missed">Enquiries missed or answered late in the last 2 weeks?<span aria-hidden="true">*</span></label>
          <input type="number" id="df-missed" name="missed_enquiries_2wk" min="0" max="100000" step="1" required aria-required="true" />
        </div>
        <div class="diagnostic-form__field">
          <label for="df-deal">Average job/client value, AUD<span aria-hidden="true">*</span></label>
          <input type="number" id="df-deal" name="avg_deal_value_aud" min="0" max="10000000" step="1" required aria-required="true" />
        </div>
      </div>

      <div class="diagnostic-form__row">
        <div class="diagnostic-form__field">
          <label for="df-channel">Where do most enquiries come in?<span aria-hidden="true">*</span></label>
          <select id="df-channel" name="channel" required aria-required="true">
            <option value="" disabled selected>Select one</option>
            <option>Phone</option>
            <option>Email</option>
            <option>Instagram or Facebook DM</option>
            <option>WhatsApp</option>
            <option>Website form</option>
            <option>Other</option>
          </select>
        </div>
        <div class="diagnostic-form__field">
          <label for="df-team">Team size <span class="diagnostic-form__optional">(optional)</span></label>
          <input type="text" id="df-team" name="team_size" maxlength="40" placeholder="e.g. just me, 2-5, 6+" />
        </div>
      </div>

      <div class="diagnostic-form__field">
        <label for="df-afterhours">What happens after hours or when you're busy?<span aria-hidden="true">*</span></label>
        <input type="text" id="df-afterhours" name="after_hours_behavior" maxlength="500" required aria-required="true" placeholder="e.g. nothing until next day, goes to voicemail..." />
      </div>

      <div class="diagnostic-form__field">
        <label for="df-tools">Tools you already use <span class="diagnostic-form__optional">(optional)</span></label>
        <input type="text" id="df-tools" name="tools_used" maxlength="300" placeholder="e.g. Cal.com, Instagram, a shared inbox..." />
      </div>

      <div class="diagnostic-form__row">
        <div class="diagnostic-form__field">
          <label for="df-replytime">How fast do you usually reply right now? <span class="diagnostic-form__optional">(optional)</span></label>
          <input type="text" id="df-replytime" name="response_time_current" maxlength="200" />
        </div>
        <div class="diagnostic-form__field">
          <label for="df-booking">How do people currently book with you? <span class="diagnostic-form__optional">(optional)</span></label>
          <input type="text" id="df-booking" name="booking_flow_current" maxlength="300" />
        </div>
      </div>

      <div class="diagnostic-form__field">
        <label for="df-frustration">Biggest thing slowing you down? <span class="diagnostic-form__optional">(optional)</span></label>
        <textarea id="df-frustration" name="biggest_frustration" rows="2" maxlength="1000"></textarea>
      </div>

      <fieldset class="diagnostic-form__field diagnostic-form__nextstep">
        <legend>How should we send you the result?<span aria-hidden="true">*</span></legend>
        <label class="diagnostic-form__radio">
          <input type="radio" name="preferred_next_step" value="email" checked required />
          Email <span class="diagnostic-form__optional">(recommended)</span>
        </label>
        <label class="diagnostic-form__radio">
          <input type="radio" name="preferred_next_step" value="whatsapp_bot" />
          WhatsApp <span class="diagnostic-form__optional">(automated)</span>
        </label>
        <label class="diagnostic-form__radio">
          <input type="radio" name="preferred_next_step" value="call" />
          Book a quick call
        </label>
      </fieldset>

      <!-- Honeypot — hidden from real users, catches simple bots. -->
      <div class="diagnostic-form__honeypot" aria-hidden="true">
        <label for="df-company-website">Leave this field empty</label>
        <input type="text" id="df-company-website" name="company_website" tabindex="-1" autocomplete="off" />
      </div>

      <button type="submit" class="diagnostic-form__send">
        <span class="diagnostic-form__send-label">Get my Diagnostic</span>
      </button>
      <p id="diagnostic-form-status" class="diagnostic-form__status" role="status" aria-live="polite"></p>
    </form>
  </div>

  <style>
    .diagnostic-wrapper {
      max-width: var(--max-content);
      width: 100%;
      margin-inline: auto;
    }
    .diagnostic-glass {
      max-width: 640px;
      background: linear-gradient(135deg, rgba(75, 186, 139, 0.08) 0%, rgba(62, 127, 168, 0.04) 100%);
      border: 1px solid rgba(75, 186, 139, 0.2);
      border-radius: 16px;
      padding: var(--space-12);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      position: relative;
    }
    .diagnostic-form {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }
    .diagnostic-form__row {
      display: grid;
      gap: 20px;
    }
    @media (min-width: 600px) {
      .diagnostic-form__row {
        grid-template-columns: 1fr 1fr;
      }
    }
    .diagnostic-form__field {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .diagnostic-form__field label,
    .diagnostic-form__nextstep legend {
      font-family: var(--mono);
      font-size: var(--text-sm);
      letter-spacing: 0.06em;
      color: var(--ink);
      font-weight: 600;
      margin-bottom: 8px;
      display: block;
      padding: 0;
    }
    .diagnostic-form__optional {
      color: var(--ink-3);
      font-weight: 400;
    }
    .diagnostic-form__field input,
    .diagnostic-form__field select,
    .diagnostic-form__field textarea {
      width: 100%;
      box-sizing: border-box;
      padding: 12px 14px;
      border-radius: 8px;
      border: 1px solid var(--rule);
      background: color-mix(in srgb, var(--surface-2) 70%, transparent);
      color: var(--ink);
      font-family: var(--display);
      font-size: var(--text-base);
      transition: border-color 0.18s ease, background 0.18s ease;
    }
    .diagnostic-form__field input:focus,
    .diagnostic-form__field select:focus,
    .diagnostic-form__field textarea:focus {
      outline: none;
      border-color: var(--accent);
      background: color-mix(in srgb, var(--surface-2) 80%, transparent);
    }
    .diagnostic-form__nextstep {
      border: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .diagnostic-form__radio {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--display);
      font-size: var(--text-base);
      color: var(--ink);
      font-weight: 400;
      cursor: pointer;
    }
    .diagnostic-form__radio input {
      width: auto;
      accent-color: var(--accent);
    }
    .diagnostic-form__honeypot {
      display: none;
    }
    .diagnostic-form__send {
      align-self: flex-start;
      margin-top: 12px;
      padding: 13px 28px;
      border-radius: 8px;
      border: 1px solid transparent;
      background: linear-gradient(180deg, var(--accent) 0%, #2e8a66 100%);
      color: #02110b;
      font-family: var(--display);
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.18s ease, box-shadow 0.18s ease;
      box-shadow: 0 0 0 1px rgba(75, 186, 139, 0.4), 0 8px 24px -10px rgba(75, 186, 139, 0.7);
    }
    .diagnostic-form__send:hover {
      transform: translateY(-1px);
      box-shadow: 0 0 0 1px rgba(75, 186, 139, 0.4), 0 10px 30px -14px rgba(75, 186, 139, 0.9);
    }
    .diagnostic-form__status {
      font-family: var(--mono);
      font-size: var(--text-xs);
      letter-spacing: 0.06em;
      color: var(--ink-2);
      margin: 0;
    }
  </style>

  <script type="module">
    // Inline form submit via fetch — mirrors ContactForm.astro's pattern: JSON with
    // a form_ts timestamp so the /api/diagnostic.ts honeypot + minimum-fill checks work.
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('diagnostic-form');
      const status = document.getElementById('diagnostic-form-status');
      if (!form || !status) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formTs = Date.now();
        const formData = new FormData(form);
        const payload = {};
        for (const [key, value] of formData.entries()) {
          if (key === 'company_website') continue; // skip honeypot from client payload
          if (key === 'missed_enquiries_2wk' || key === 'avg_deal_value_aud') {
            payload[key] = Number(value);
          } else {
            payload[key] = value;
          }
        }
        payload.form_ts = formTs;

        status.textContent = 'Sending…';
        try {
          const res = await fetch('/api/diagnostic', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (res.ok) {
            form.reset();
            status.textContent = 'Thanks — check your email in a few minutes for your Diagnostic.';
          } else {
            status.textContent = data.error || 'Something went wrong. Please try again.';
          }
        } catch {
          status.textContent = 'Network error. Please try again.';
        }
      });
    });
  </script>
</div>

---
---

<header class="header">
  <div class="header__container">
    <a class="header__brand" href="/">
      <img src="/logo-mark.png" alt="" class="header__mark" />
      <span class="header__logo-text">SyncSet</span>
    </a>
    <nav class="header__nav" aria-label="Primary">
      <a class="header__nav-link" href="/#how-it-works">How it works</a>
      <a class="header__nav-link" href="/#pricing">Pricing</a>
    </nav>
    <a class="btn btn-primary header__cta" href="/book">Book a workflow audit</a>
  </div>
</header>

<style>
  .header {
    background-color: var(--ground);
    border-bottom: 1px solid var(--rule);
    padding: var(--space-4) var(--gutter);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header__container {
    max-width: var(--max-content);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .header__brand {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .header__mark {
    width: 26px;
    height: 26px;
    display: block;
    filter: drop-shadow(0 0 8px rgba(111, 221, 174, 0.45));
  }

  .header__logo-text {
    font-family: var(--display);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 26px;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-2);
    flex: 1 1 auto;
    justify-content: center;
  }

  .header__nav-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .header__nav-link:hover {
    color: var(--ink);
  }

  @media (max-width: 760px) {
    .header__nav {
      display: none;
    }
  }

  /* the hero carries the same CTA one screen down; two of them overflow a 390px header */
  @media (max-width: 560px) {
    .header__cta {
      display: none;
    }
  }
</style>

---
---

<header class="header">
  <div class="header__container">
    <a class="header__brand" href="/">
      <img src="/logo-mark.png" alt="" class="header__mark" />
      <span class="header__logo-text">SyncSet</span>
    </a>
    <nav class="header__nav" aria-label="Primary">
      <a class="header__nav-link" href="/#how-it-works">How it works</a>
      <a class="header__nav-link" href="/#pricing">Pricing</a>
    </nav>
    <a class="btn btn-primary header__cta" href="/#diagnostic">Free Diagnostic</a>
  </div>
</header>

<style>
  .header {
    background-color: var(--ground);
    border-bottom: 1px solid var(--rule);
    padding: var(--space-4) var(--gutter);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header__container {
    max-width: var(--max-content);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .header__brand {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .header__mark {
    width: 36px;
    height: 36px;
    display: block;
    filter: drop-shadow(0 0 8px rgba(111, 221, 174, 0.45));
  }

  .header__logo-text {
    font-family: var(--display);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 26px;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-2);
    flex: 1 1 auto;
    justify-content: center;
  }

  .header__nav-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.18s ease;
    /* 44px tall hit area without changing the visual rhythm */
    padding: 12px 4px;
    margin: -12px -4px;
  }

  .header__nav-link:hover {
    color: var(--ink);
  }

  @media (max-width: 760px) {
    .header__nav {
      display: none;
    }
  }

  /* Keep the primary CTA reachable from the header on phones; only the nav folds. */
  @media (max-width: 560px) {
    .header__cta {
      padding: 10px 14px;
      font-size: 13px;
      white-space: nowrap;
    }
  }
  @media (max-width: 400px) {
    .header__cta {
      padding: 10px 11px;
      font-size: 12px;
    }
  }
</style>

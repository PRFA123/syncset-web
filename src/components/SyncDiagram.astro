---
---

<div class="sync-diagram-wrapper">
  <svg
    viewBox="0 0 1200 300"
    xmlns="http://www.w3.org/2000/svg"
    class="sync-diagram"
    aria-label="SyncSet workflow diagram showing input channels flowing to SyncSet and outputs flowing to customer touchpoints"
  >
    <!-- Left inputs -->
    <g class="input-group input-missed-call">
      <text x="50" y="80" class="diagram-label">missed call</text>
    </g>

    <g class="input-group input-whatsapp">
      <text x="50" y="150" class="diagram-label">WhatsApp DM</text>
    </g>

    <g class="input-group input-form">
      <text x="50" y="220" class="diagram-label">web form</text>
    </g>

    <!-- Connectors to center -->
    <g class="connector connector-left">
      <line x1="180" y1="80" x2="380" y2="150" stroke-dasharray="100" />
      <line x1="180" y1="150" x2="380" y2="150" stroke-dasharray="100" />
      <line x1="180" y1="220" x2="380" y2="150" stroke-dasharray="100" />
    </g>

    <!-- Center node -->
    <g class="center-node">
      <rect x="380" y="120" width="120" height="60" rx="4" />
      <text x="440" y="155" class="diagram-label center-label">SyncSet</text>
    </g>

    <!-- Connectors from center -->
    <g class="connector connector-right">
      <line x1="500" y1="130" x2="700" y2="80" stroke-dasharray="100" />
      <line x1="500" y1="150" x2="700" y2="150" stroke-dasharray="100" />
      <line x1="500" y1="170" x2="700" y2="220" stroke-dasharray="100" />
    </g>

    <!-- Right outputs -->
    <g class="output-group output-crm">
      <text x="700" y="80" class="diagram-label">CRM updated</text>
    </g>

    <g class="output-group output-sms">
      <text x="700" y="150" class="diagram-label">SMS sent</text>
    </g>

    <g class="output-group output-notion">
      <text x="700" y="220" class="diagram-label">Notion logged</text>
    </g>

    <!-- Final outputs (booked, etc) -->
    <g class="final-output">
      <text x="950" y="115" class="diagram-label">booked</text>
    </g>
  </svg>

  <p class="sync-diagram-caption">This is what we'd build for you.</p>
</div>

<style>
  .sync-diagram-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    margin: var(--space-16) 0;
  }

  .sync-diagram {
    width: 100%;
    max-width: 1000px;
    height: auto;
  }

  .diagram-label {
    font-family: var(--font-system);
    font-size: 13px;
    fill: var(--ink);
    font-weight: 400;
  }

  .center-label {
    fill: var(--paper);
  }

  .sync-diagram rect {
    fill: var(--ink);
    animation: pulse 2s var(--ease-out) 3s infinite;
  }

  .sync-diagram line {
    stroke: var(--rule);
    stroke-width: 1.5;
    fill: none;
  }

  .input-group {
    opacity: 0;
    animation: fadeInSlide 600ms var(--ease-out) forwards;
  }

  .input-missed-call {
    animation-delay: 0s;
  }

  .input-whatsapp {
    animation-delay: 400ms;
  }

  .input-form {
    animation-delay: 800ms;
  }

  .output-group {
    opacity: 0;
    animation: fadeInSlide 600ms var(--ease-out) forwards;
  }

  .output-crm {
    animation-delay: 2.4s;
  }

  .output-sms {
    animation-delay: 2.8s;
  }

  .output-notion {
    animation-delay: 3.2s;
  }

  .final-output {
    opacity: 0;
    animation: fadeInSlide 600ms var(--ease-out) 3.6s forwards;
  }

  .connector-left line {
    animation: drawLine 800ms var(--ease-out) 1.2s forwards;
  }

  .connector-right line {
    animation: drawLine 800ms var(--ease-out) 2s forwards;
  }

  .sync-diagram-caption {
    font-size: var(--text-xs);
    color: var(--graphite);
    text-align: center;
    margin: 0;
  }

  @keyframes fadeInSlide {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes drawLine {
    from {
      stroke-dashoffset: 100;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sync-diagram {
      animation: none !important;
    }

    .sync-diagram * {
      animation: none !important;
    }

    .input-group,
    .output-group,
    .final-output {
      opacity: 1 !important;
    }

    .sync-diagram rect {
      animation: none !important;
    }

    .connector-left line,
    .connector-right line {
      stroke-dashoffset: 0 !important;
    }
  }
</style>

---
interface Props {
  variant?: 'primary' | 'ghost';
  subtext?: boolean;
}

const { variant = 'primary', subtext = false } = Astro.props;
---

<div class="cta-wrapper">
  <a href="/book" class={`btn btn-${variant}`}>Book a Workflow Audit →</a>
  {subtext && <p class="cta-subtext">20 minutes. Free. No commitment.</p>}
</div>

<style>
  .cta-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .cta-subtext {
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: 0;
  }
</style>

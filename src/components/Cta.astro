---
interface Props {
  variant?: 'primary' | 'ghost';
  subtext?: boolean;
  label?: string;
}

const { variant = 'primary', subtext = false, label = '' } = Astro.props;
---

<div class="cta-wrapper">
  <a href={variant === 'ghost' ? '#contact' : '/book/'} class={`btn btn-${variant}`}>{label || 'Book a Workflow Audit →'}</a>
  {subtext && <p class="cta-subtext">20 minutes. Free. No commitment.</p>}
</div>

<style>
  .cta-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .cta-subtext {
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: 0;
  }
</style>

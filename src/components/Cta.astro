---
interface Props {
  variant?: 'primary' | 'ghost';
  subtext?: boolean;
  label?: string;
  href?: string;
}

const { variant = 'primary', subtext = false, label = '', href = '' } = Astro.props;
const resolvedHref = href || (variant === 'ghost' ? '#contact' : '/#diagnostic');
---

<div class="cta-wrapper">
  <a href={resolvedHref} class={`btn btn-${variant}`}>{label || 'Free Diagnostic →'}</a>
  {subtext && <p class="cta-subtext">About 10 minutes. Free. No commitment.</p>}
</div>

<style>
  .cta-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .cta-subtext {
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: 0;
  }
</style>

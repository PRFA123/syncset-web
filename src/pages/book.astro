---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Book a Workflow Audit — SyncSet"
  description="Schedule your free 20-minute workflow audit with SyncSet. No commitment, no slides."
>
  <Header />

  <main id="main-content">
    <section class="booking">
      <div class="booking__container">
        <h1 class="booking__title">Book a Workflow Audit</h1>
        <p class="booking__description">
          20 minutes. Free. No commitment. Let's talk about where you're losing clients to slow responses.
        </p>

        <!-- Cal.com embed -->
        <div class="booking__embed">
          <iframe
            src="https://cal.com/syncset/audit"
            style="border:none;border-radius:4px;overflow:hidden;"
            width="100%"
            height="600"
            frameborder="0"
            title="Schedule a workflow audit with SyncSet"
          ></iframe>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .booking {
    min-height: calc(100vh - 200px);
    padding: var(--space-24) var(--gutter);
    background-color: var(--paper);
  }

  .booking__container {
    max-width: var(--max-content);
    margin: 0 auto;
  }

  .booking__title {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: var(--space-4);
  }

  .booking__description {
    font-size: var(--text-base);
    color: var(--graphite);
    margin-bottom: var(--space-12);
    line-height: 1.6;
  }

  .booking__embed {
    max-width: 800px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .booking {
      padding: var(--space-16) var(--gutter);
    }

    .booking__title {
      font-size: var(--text-xl);
    }
  }
</style>

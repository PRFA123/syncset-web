---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Book a Workflow Audit, SyncSet"
  description="Schedule your free 20-minute workflow audit with SyncSet. No commitment, no slides."
>
  <Header />

  <main id="main-content">
    <section class="booking">
      <div class="booking__container">
        <h1 class="booking__title">Book a Workflow Audit</h1>
        <p class="booking__description">
          20 minutes. Free. No commitment. Let's talk about where you're losing clients to slow responses.
        </p>

        <!-- Cal.com official inline embed. A raw <iframe src="https://cal.com/..."> is
             blocked by Cal.com's frame-ancestors policy on third-party origins, so this
             loads the same view through their postMessage-based embed script instead. -->
        <div class="booking__embed">
          <div id="cal-booking-inline" class="cal-inline-target"></div>
          <noscript>
            <p>
              JavaScript is required to show the live calendar. You can also book directly at
              <a href="https://cal.com/syncset/30min" target="_blank" rel="noopener">cal.com/syncset/30min</a>.
            </p>
          </noscript>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .booking {
    min-height: calc(100vh - 200px);
    padding: var(--space-24) var(--gutter);
    background-color: var(--paper);
  }

  .booking__container {
    max-width: var(--max-content);
    margin: 0 auto;
  }

  .booking__title {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: var(--space-4);
  }

  .booking__description {
    font-size: var(--text-base);
    color: var(--graphite);
    margin-bottom: var(--space-12);
    line-height: 1.6;
  }

  .booking__embed {
    max-width: 800px;
    margin: 0 auto;
  }

  .cal-inline-target {
    width: 100%;
    min-height: 600px;
    overflow: hidden;
    border-radius: 4px;
  }

  @media (max-width: 768px) {
    .booking {
      padding: var(--space-16) var(--gutter);
    }

    .booking__title {
      font-size: var(--text-xl);
    }
  }
</style>

<script>
  // Official Cal.com embed loader (their standard "add to your site" snippet).
  // Keep this in sync with https://cal.com/help/embedding/embed-instructions if it
  // ever changes upstream.
  (function (C: any, A: string, L: string) {
    let p = function (a: any, ar: any) {
      a.q.push(ar);
    };
    let d = C.document;
    C.Cal =
      C.Cal ||
      function (...args: any[]) {
        let cal = C.Cal;
        let ar = args;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement('script')).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function (...apiArgs: any[]) {
            p(api, apiArgs);
          };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === 'string') {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ['initNamespace', namespace]);
          } else {
            p(cal, ar);
          }
          return;
        }
        p(cal, ar);
      };
  })(window, 'https://app.cal.com/embed/embed.js', 'init');

  // @ts-ignore — Cal is attached to window by the loader above
  Cal('init', '30min', { origin: 'https://cal.com' });

  // @ts-ignore
  Cal.ns['30min']('inline', {
    elementOrSelector: '#cal-booking-inline',
    calLink: 'syncset/30min',
    config: { layout: 'month_view' },
  });

  // @ts-ignore
  Cal.ns['30min']('ui', {
    hideEventTypeDetails: false,
    layout: 'month_view',
  });
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cta from '../components/Cta.astro';
import SyncDiagram from '../components/SyncDiagram.astro';
import Faq from '../components/Faq.astro';
import {
  generateOrganizationSchema,
  generateLocalBusinessSchema,
  generateWebSiteSchema,
} from '../lib/schema';

const organizationSchema = generateOrganizationSchema();
const localBusinessSchema = generateLocalBusinessSchema();
const websiteSchema = generateWebSiteSchema();
---

<BaseLayout>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify([organizationSchema, localBusinessSchema, websiteSchema])} />
  </Fragment>

  <Header />

  <main id="main-content">
    <!-- Section 1: Hero -->
    <section class="hero">
      <div class="hero__container">
        <h1 class="hero__headline">Every missed enquiry becomes a booked job.<br />Nobody types a thing.</h1>
        <p class="hero__subhead">We connect the tools your business already runs, so the follow-up happens by itself.</p>
        <div class="hero__cta">
          <Cta variant="dark" subtext />
        </div>
        <SyncDiagram />
      </div>
    </section>

    <!-- Section 2: The Problem -->
    <section class="problem">
      <div class="problem__container">
        <blockquote class="problem__quote">
          "It all comes in on WhatsApp. I read it, write it in the notebook, then type it into the system. When I get a chance."
        </blockquote>
        <div class="problem__body">
          <p>
            Most business owners we talk to aren't losing clients because they don't care. They're losing them because the reply that should take 30 seconds takes 3 hours — and by then, the client has moved on.
          </p>
          <p>
            The problem isn't the tools. It's the gap between them. Every time someone reads a message and re-types it somewhere else, that's a gap. Every time a booking sits in a WhatsApp thread waiting to be entered into a calendar, that's a gap. Every gap is a place where a client can disappear.
          </p>
          <p>
            You already know this. You've probably tried to fix it — a person to manage the messages, a system nobody ended up using, a spreadsheet that worked for a week. The issue isn't effort. It's that none of those things close the gap automatically.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 3: Proof -->
    <section class="proof">
      <div class="proof__container">
        <h2 class="proof__title">What it looks like in practice.</h2>
        <div class="proof__case">
          <p class="proof__label">How do we know this works? We run it on ourselves.</p>
          <p>
            Every enquiry to syncset.com.au goes through the same system we'd build for you — form to CRM to confirmation in under 60 seconds, unattended. That number is what we'll put here when we've measured it for 30 days.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 4: How It Works -->
    <section class="how-it-works">
      <div class="how-it-works__container">
        <h2 class="how-it-works__title">How it works.</h2>
        <div class="how-it-works__steps">
          <div class="step">
            <div class="step__number">1</div>
            <h3 class="step__title">Audit</h3>
            <p class="step__body">
              We spend 20 minutes learning where your enquiries come in, where they get lost, and what a fix would actually look like. Free. No slides, no proposal theatre.
            </p>
          </div>
          <div class="step">
            <div class="step__number">2</div>
            <h3 class="step__title">Architect</h3>
            <p class="step__body">
              We map the workflow and show you exactly what we'll build before we touch anything. You approve it. If it doesn't make sense to you, we don't proceed.
            </p>
          </div>
          <div class="step">
            <div class="step__number">3</div>
            <h3 class="step__title">Build</h3>
            <p class="step__body">
              We connect your existing tools and build the automation. Most first builds take 1–3 weeks. You own everything we build — the workflows, the data, the integrations. Not us.
            </p>
          </div>
          <div class="step">
            <div class="step__number">4</div>
            <h3 class="step__title">Operate</h3>
            <p class="step__body">
              We monitor and adjust. If something breaks, we fix it — not you. No lock-in. If you ever want to take it in-house or switch providers, the system goes with you.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 5: Pricing -->
    <section class="pricing">
      <div class="pricing__container">
        <h2 class="pricing__title">What it costs.</h2>
        <p class="pricing__headline">Pilots start at A$900. Most first builds run A$1,800–2,500.</p>
        <p class="pricing__body">
          Fixed scope, fixed price — no monthly retainer until you've seen it work. The pilot covers one workflow end-to-end: usually enquiry capture to booking confirmation. If it works, we build from there. If it doesn't do what we said it would, you don't pay the second half.
        </p>
        <p class="pricing__trust">No lock-in. No ongoing fees unless you want them. You own the system.</p>
      </div>
    </section>

    <!-- Section 6: FAQ -->
    <Faq />

    <!-- Section 7: Final CTA -->
    <section class="cta-final">
      <div class="cta-final__container">
        <h2 class="cta-final__text">Every missed enquiry becomes a booked job.<br />Nobody types a thing.</h2>
        <div class="cta-final__button">
          <Cta variant="green" subtext />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Hero Section */
  .hero {
    padding: var(--space-32) var(--gutter);
    background-color: var(--paper);
  }

  .hero__container {
    max-width: var(--max-content);
    margin: 0 auto;
  }

  .hero__headline {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: var(--space-6);
    line-height: 1.3;
  }

  .hero__subhead {
    font-size: var(--text-base);
    color: var(--graphite);
    margin-bottom: var(--space-8);
    line-height: 1.6;
    max-width: 600px;
  }

  .hero__cta {
    margin-bottom: var(--space-24);
  }

  /* Problem Section */
  .problem {
    padding: var(--space-32) var(--gutter);
    background-color: var(--surface);
  }

  .problem__container {
    max-width: var(--max-content);
    margin: 0 auto;
  }

  .problem__quote {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 var(--space-12) 0;
    line-height: 1.3;
  }

  .problem__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    color: var(--graphite);
    line-height: 1.6;
    max-width: 900px;
  }

  .problem__body p {
    margin: 0;
  }

  /* Proof Section */
  .proof {
    padding: var(--space-32) var(--gutter);
    background-color: var(--paper);
  }

  .proof__container {
    max-width: var(--max-content);
    margin: 0 auto;
  }

  .proof__title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: var(--space-12);
  }

  .proof__case {
    background-color: var(--surface);
    padding: var(--space-8);
    border-radius: 4px;
    color: var(--graphite);
    line-height: 1.6;
  }

  .proof__label {
    font-weight: 500;
    color: var(--ink);
    margin-bottom: var(--space-4);
  }

  .proof__case p {
    margin: 0;
  }

  /* How It Works */
  .how-it-works {
    padding: var(--space-32) var(--gutter);
    background-color: var(--surface);
  }

  .how-it-works__container {
    max-width: var(--max-content);
    margin: 0 auto;
  }

  .how-it-works__title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: var(--space-12);
  }

  .how-it-works__steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-8);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .step__number {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--running);
  }

  .step__title {
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--ink);
    margin: 0;
  }

  .step__body {
    font-size: var(--text-base);
    color: var(--graphite);
    line-height: 1.6;
    margin: 0;
  }

  /* Pricing */
  .pricing {
    padding: var(--space-32) var(--gutter);
    background-color: var(--paper);
  }

  .pricing__container {
    max-width: var(--max-content);
    margin: 0 auto;
  }

  .pricing__title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: var(--space-6);
  }

  .pricing__headline {
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--ink);
    margin-bottom: var(--space-6);
  }

  .pricing__body {
    font-size: var(--text-base);
    color: var(--graphite);
    line-height: 1.6;
    margin-bottom: var(--space-6);
    max-width: 800px;
  }

  .pricing__trust {
    font-size: var(--text-base);
    color: var(--ink);
    font-weight: 500;
    margin: 0;
  }

  /* Final CTA */
  .cta-final {
    padding: var(--space-32) var(--gutter);
    background-color: var(--ink);
    color: var(--paper);
  }

  .cta-final__container {
    max-width: var(--max-content);
    margin: 0 auto;
    text-align: center;
  }

  .cta-final__text {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--paper);
    margin-bottom: var(--space-12);
    line-height: 1.3;
  }

  .cta-final__button {
    display: flex;
    justify-content: center;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero__headline {
      font-size: var(--text-xl);
    }

    .problem__quote {
      font-size: var(--text-lg);
    }

    .how-it-works__steps {
      grid-template-columns: 1fr;
    }
  }
</style>

  <script>
    // SMIL (<animateMotion>) ignores CSS, so reduced-motion has to pause it here.
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const applyMotion = () => {
      document.querySelectorAll('svg').forEach((svg) => {
        motion.matches ? svg.pauseAnimations() : svg.unpauseAnimations();
      });
    };
    applyMotion();
    motion.addEventListener('change', applyMotion);

    // Rail: two tapered lines chasing the flow frame's border, ported from the
    // Visual Direction artifact's own script (the technique that v28.css's header
    // comment originally marked as "not ported, the hardest one" — this replaces
    // the simpler single-runner fallback that was standing in for it). Both rails
    // are the same rounded-rect outline starting at TOP CENTRE, walked in opposite
    // directions; sampling by actual arc length (getPointAtLength) rather than a
    // conic-gradient/angle approach keeps travel speed constant regardless of the
    // frame's aspect ratio, so it doesn't distort on a wide, short frame like this
    // one. Each pair reaches BOTTOM CENTRE together, fades out, and restarts.
    const rail = document.querySelector<SVGSVGElement>('.flow .rail');
    if (rail) {
      const frame = rail.parentElement as HTMLElement;
      const railCw = rail.querySelector<SVGPathElement>('.rail-cw')!;
      const railCcw = rail.querySelector<SVGPathElement>('.rail-ccw')!;
      const taperCw = rail.querySelector<SVGPathElement>('.taper-cw')!;
      const taperCcw = rail.querySelector<SVGPathElement>('.taper-ccw')!;
      const pairs: [SVGPathElement, SVGPathElement][] = [
        [railCw, taperCw],
        [railCcw, taperCcw],
      ];

      const DUR = 5200; // ms per full travel-and-fade cycle
      const HEAD_W = 1.1;
      const SPAN = 0.13; // fraction of total length the taper's tail reaches back
      const SAMPLES = 64;
      const FADE_PEAK = 0.52;
      const FADE_IN = 0.08; // fraction of the cycle spent rising to full opacity
      const FADE_OUT = 0.08; // fraction of the cycle spent falling, right before the meet
      let t0 = 0;
      let raf = 0;
      let visible = false;

      // Rounded-rect outline starting at top centre, walked clockwise (cw) or
      // counter-clockwise; both directions cover exactly half the perimeter by
      // the time they reach bottom centre, since the shape is left-right symmetric.
      const outline = (w: number, h: number, r: number, cw: boolean) => {
        const cx = w / 2;
        return (
          `M ${1 + cx} 1` +
          (cw
            ? ` H ${1 + w - r} A ${r} ${r} 0 0 1 ${1 + w} ${1 + r}` +
              ` V ${1 + h - r} A ${r} ${r} 0 0 1 ${1 + w - r} ${1 + h}` +
              ` H ${1 + r} A ${r} ${r} 0 0 1 1 ${1 + h - r}` +
              ` V ${1 + r} A ${r} ${r} 0 0 1 ${1 + r} 1`
            : ` H ${1 + r} A ${r} ${r} 0 0 0 1 ${1 + r}` +
              ` V ${1 + h - r} A ${r} ${r} 0 0 0 ${1 + r} ${1 + h}` +
              ` H ${1 + w - r} A ${r} ${r} 0 0 0 ${1 + w} ${1 + h - r}` +
              ` V ${1 + r} A ${r} ${r} 0 0 0 ${1 + w - r} 1`) +
          ` H ${1 + cx}`
        );
      };

      const layout = () => {
        const w = frame.offsetWidth;
        const h = frame.offsetHeight;
        const r = 16;
        if (w <= 2 * r || h <= 2 * r) return;
        rail.setAttribute('viewBox', `0 0 ${w} ${h}`);
        railCw.setAttribute('d', outline(w, h, r, true));
        railCcw.setAttribute('d', outline(w, h, r, false));
      };

      const smoothstep = (x: number) => {
        x = x < 0 ? 0 : x > 1 ? 1 : x;
        return x * x * (3 - 2 * x);
      };

      // Samples a short stretch of the rail behind `headLen` and builds a polygon
      // that tapers to a point at the tail — the only way to get a true taper,
      // since a stroke has one uniform width.
      const taperShape = (railPath: SVGPathElement, headLen: number, total: number, minLen: number) => {
        const span = total * SPAN;
        const pts: [number, number][] = [];
        const back: [number, number][] = [];
        for (let i = 0; i <= SAMPLES; i++) {
          const t = i / SAMPLES;
          const L = headLen - t * span;
          if (L < minLen) break;
          const p = railPath.getPointAtLength(L);
          const d = 0.8;
          const a = railPath.getPointAtLength(Math.max(L - d, 0));
          const b = railPath.getPointAtLength(Math.min(L + d, total));
          const dx = b.x - a.x;
          const dy = b.y - a.y;
          const m = Math.hypot(dx, dy);
          if (!m) continue;
          const nx = -dy / m;
          const ny = dx / m;
          const half = (HEAD_W * Math.pow(1 - t, 1.25)) / 2;
          pts.push([p.x + nx * half, p.y + ny * half]);
          back.push([p.x - nx * half, p.y - ny * half]);
        }
        if (pts.length < 2) return '';
        back.reverse();
        const fmt = (q: [number, number]) => `${q[0].toFixed(2)} ${q[1].toFixed(2)}`;
        return `M${pts.map(fmt).join('L')}L${back.map(fmt).join('L')}Z`;
      };

      const tick = (now: number) => {
        if (!visible || motion.matches) {
          raf = 0;
          return;
        }
        if (!t0) t0 = now;
        const phase = ((now - t0) % DUR) / DUR;
        // Ease-in-out pacing (the same smoothstep used for the fade, just applied to
        // position too): slow leaving top centre, fastest mid-travel, slow again on
        // arrival — a "comet" feel instead of the flat, constant-speed travel a plain
        // linear phase would give.
        const eased = smoothstep(phase);
        for (const [railPath, taperEl] of pairs) {
          const d = railPath.getAttribute('d');
          if (!d) continue;
          const total = railPath.getTotalLength();
          const gap = total * 0.1; // small gap at top centre keeps the two tails apart
          const head = gap + eased * (total * 0.5 - gap);
          taperEl.setAttribute('d', taperShape(railPath, head, total, gap));
          // Quick rise, a long steady plateau at full brightness, then a fall
          // concentrated in the last instants before the two lines touch at
          // bottom centre — not a gradual fade spread across the whole travel.
          const fade = FADE_PEAK * smoothstep(phase / FADE_IN) * smoothstep((1 - phase) / FADE_OUT);
          taperEl.setAttribute('opacity', fade.toFixed(3));
        }
        raf = requestAnimationFrame(tick);
      };
      const start = () => {
        if (!raf && visible && !motion.matches) {
          t0 = 0;
          raf = requestAnimationFrame(tick);
        }
      };

      layout();
      new ResizeObserver(layout).observe(frame);
      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          start();
        },
        { rootMargin: '40px' },
      ).observe(frame);
      motion.addEventListener('change', () => {
        if (motion.matches) {
          taperCw.setAttribute('d', '');
          taperCcw.setAttribute('d', '');
        }
        start();
      });
    }

    // Official brand marks already live in public/logos — this just proves each file
    // loads before showing it, so a missing SVG never renders as a broken image.
    document.querySelectorAll<HTMLElement>('.app-tile[data-logo]').forEach((tile) => {
      const img = tile.querySelector('img');
      if (!img) return;
      img.addEventListener('error', () => {
        tile.textContent = (tile.getAttribute('title') || '?').charAt(0);
      });
    });
  </script>

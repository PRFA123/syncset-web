{
  "name": "syncset-web",
  "main": "dist/server/entry.mjs",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": true
}
